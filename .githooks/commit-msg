#!/usr/bin/env bash
# 커밋 메시지 규칙 강제:
#   1) 한글 포함 (한글로 작성)
#   2) AI 출처/서명 트레일러 금지 (Co-Authored-By 등)
set -euo pipefail

msg_file="$1"
msg="$(cat "$msg_file")"

if echo "$msg" | grep -Eqi 'co-authored-by|generated[- ]with|claude code|🤖'; then
  echo "오류: 커밋 메시지에 AI 출처/서명 트레일러를 포함할 수 없습니다." >&2
  echo "      (Co-Authored-By, Generated with 등의 문구를 제거해주세요)" >&2
  exit 1
fi

if ! perl -CSD -ne '$found=1 if /[\x{AC00}-\x{D7A3}]/; END { exit($found ? 0 : 1) }' <<< "$msg"; then
  echo "오류: 커밋 메시지는 한글로 작성해야 합니다." >&2
  exit 1
fi

exit 0
